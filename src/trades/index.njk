<!-- Pricing toggle & form handler -->
<script>
(function () {
  /* ── Pricing toggle ── */
  var toggleBtns = document.querySelectorAll('.trades-toggle-btn');
  var priceValues = document.querySelectorAll('.trades-price-value');
  var pricePeriods = document.querySelectorAll('.trades-price-period');

  toggleBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var period = btn.dataset.period;
      toggleBtns.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');

      priceValues.forEach(function (el) {
        el.textContent = el.dataset[period];
      });
      pricePeriods.forEach(function (el) {
        el.textContent = '/' + el.dataset[period + 'Label'];
      });
    });
  });

  /* ── Form submission (Web3Forms) ── */
  var form = document.getElementById('trades-form');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();

    /* Basic validation */
    var valid = true;
    form.querySelectorAll('[required]').forEach(function (field) {
      var err = field.parentElement.querySelector('.field-error');
      if (!field.value.trim()) {
        valid = false;
        field.classList.add('error');
        if (err) err.textContent = 'This field is required';
      } else {
        field.classList.remove('error');
        if (err) err.textContent = '';
      }
    });
    if (!valid) return;

    var submitBtn = form.querySelector('.form-submit');
    var btnText = form.querySelector('.btn-text');
    var btnLoad = form.querySelector('.btn-loading');
    submitBtn.disabled = true;
    btnText.hidden = true;
    btnLoad.hidden = false;

    fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(new FormData(form)))
    })
    .then(function (res) { return res.json(); })
    .then(function (data) {
      if (data.success) {
        form.querySelector('.form-success').hidden = false;
        form.reset();
      }
    })
    .catch(function () {})
    .finally(function () {
      submitBtn.disabled = false;
      btnText.hidden = false;
      btnLoad.hidden = true;
    });
  });
})();
</script>

