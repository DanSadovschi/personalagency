  <!-- ═══════════════════════════════ PROCESS ═══════════════════════════ -->
  <section id="process" class="section">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-eyebrow">How we work</p>
        <h2>Listen. Shape.<br />Launch.</h2>
      </div>
      <div class="process-list">
        <div class="process-step reveal">
          <div class="process-left">
            <span class="process-num">01</span>
          </div>
          <div class="process-right">
            <h3>Listen</h3>
            <p>We start with a conversation — not a brief. Your story, your ambition, the feeling you want people to walk away with. That's the foundation.</p>
          </div>
        </div>
        <div class="process-step reveal">
          <div class="process-left">
            <span class="process-num">02</span>
          </div>
          <div class="process-right">
            <h3>Shape</h3>
            <p>Design, code, copy — we handle it all. Two weeks, no noise. What you get is something that looks and feels like it was always meant to exist.</p>
          </div>
        </div>
        <div class="process-step reveal">
          <div class="process-left">
            <span class="process-num">03</span>
          </div>
          <div class="process-right">
            <h3>Launch</h3>
            <p>Your site goes live. We stay. Ongoing support, optimisation, and the kind of attention that most agencies stop giving after the invoice.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

