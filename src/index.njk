  <!-- ═══════════════════════════════ HERO ══════════════════════════════ -->
  <section id="hero">
    <div class="hero-bg-grid"></div>
    <div class="hero-split">
      <div class="container hero-content">
        <p class="hero-eyebrow reveal">Digital craft studio</p>
        <h1 class="hero-title reveal">
          We don't make<br />websites.<br /><span class="accent">We make presence.</span>
        </h1>
        <p class="hero-sub reveal">
          Every brand has a story worth telling well.<br class="br-lg" />
          We give it a space that feels <em>inevitable</em>.
        </p>
        <div class="hero-ctas reveal">
          <a href="/contact/" class="btn btn-lg">Start a conversation</a>
          <a href="/projects/" class="btn btn-ghost btn-lg">See the work <span class="arrow">→</span></a>
        </div>
      </div>
      <div class="hero-canvas-wrap reveal">
        <canvas id="hero-sphere"></canvas>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════ BELIEFS ══════════════════════════ -->
  <section id="why" class="section">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-eyebrow">What we believe</p>
        <h2>Good design<br />is invisible.</h2>
      </div>
      <div class="beliefs-grid">
        <div class="belief-card reveal">
          <span class="belief-num">01</span>
          <h3>Simplicity is the ultimate sophistication</h3>
          <p>We strip away everything that doesn't serve a purpose. What remains is clear, honest, and impossible to ignore.</p>
        </div>
        <div class="belief-card reveal">
          <span class="belief-num">02</span>
          <h3>Every pixel carries intent</h3>
          <p>Nothing is accidental. Spacing, rhythm, contrast — each decision is deliberate. The details are not the details. They make the product.</p>
        </div>
        <div class="belief-card reveal">
          <span class="belief-num">03</span>
          <h3>Your brand deserves a real voice</h3>
          <p>Not a template with your name on it. A space that feels like <em>you</em> — one that people remember after they close the tab.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ SERVICES ═══════════════════════════ -->
  <section id="services" class="section section-dark">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-eyebrow">What we craft</p>
        <h2>Not services.<br />Capabilities.</h2>
      </div>
      <div class="services-grid">
        <div class="service-card reveal">
          <div class="service-num">01</div>
          <h3>Design &amp; Build</h3>
          <p>Websites that feel considered. Custom code, Webflow, or Shopify — mobile-first, fast, and built to last.</p>
        </div>
        <div class="service-card reveal">
          <div class="service-num">02</div>
          <h3>Search &amp; Visibility</h3>
          <p>Local SEO that puts you where your clients are looking. Google Maps, organic search, the places that matter.</p>
        </div>
        <div class="service-card reveal">
          <div class="service-num">03</div>
          <h3>Brand Presence</h3>
          <p>Google Business setup, review strategy, and the small things that make people trust you before they call.</p>
        </div>
        <div class="service-card reveal">
          <div class="service-num">04</div>
          <h3>Campaigns &amp; Conversion</h3>
          <p>Landing pages built for action. Google Ads integration, tracking, and pages that turn clicks into conversations.</p>
        </div>
      </div>
    </div>
