  {% if collections.projects and collections.projects.length > 0 %}
  <section id="projects" class="section section-dark">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-eyebrow">Our work</p>
        <h2>Projects we're<br />proud of.</h2>
      </div>
      <div class="projects-grid">
        {% set shown = 0 %}
        {% for project in collections.projects | reverse %}
          {% set projectCover = project.data.cover or (project.data.gallery and project.data.gallery[0] and project.data.gallery[0].url) %}
          {% if shown < 3 and projectCover %}
          <a href="{{ project.url }}" class="project-card reveal">
            <div class="project-card-cover">
              <img src="{{ projectCover }}" alt="{{ project.data.title }}" loading="lazy" />
              {% if project.data.sector %}
              <span class="project-sector-tag">{{ project.data.sector }}</span>
              {% endif %}
            </div>
            <div class="project-card-body">
              <h3>{{ project.data.title }}</h3>
              {% if project.data.summary %}<p>{{ project.data.summary }}</p>{% endif %}
              <span class="project-card-link">View project →</span>
            </div>
          </a>
          {% set shown = shown + 1 %}
          {% endif %}
        {% endfor %}
      </div>
      <div class="trust-cta reveal" style="margin-top:48px;">
        <a href="/projects/" class="btn btn-ghost">See all projects <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
  {% endif %}

