---
layout: layouts/base.njk
activeNav: projects
---

<section class="project-hero">
  {% set heroImage = cover or (gallery and gallery.length > 0 and gallery[0].url) %}
  {% if heroImage %}
  <div class="project-cover-img" style="background-image: url('{{ heroImage }}')"></div>
  {% else %}
  <div class="project-cover-gradient"></div>
  {% endif %}
  <div class="container">
    <a href="/projects/" class="project-back">← All Projects</a>
    <div class="project-hero-meta">
      {% if sector %}<span class="project-sector-tag">{{ sector }}</span>{% endif %}
      {% if year %}<span class="project-year">{{ year }}</span>{% endif %}
    </div>
    <h1>{{ title }}</h1>
    {% if summary %}<p class="project-summary">{{ summary }}</p>{% endif %}
  </div>
</section>

<section class="section">
  <div class="container project-layout">

    <aside class="project-sidebar">
      <div class="project-details-card">
        {% if client %}
        <div class="project-detail-row">
          <span class="detail-label">Client</span>
          <span>{{ client }}</span>
        </div>
        {% endif %}
        {% if sector %}
        <div class="project-detail-row">
          <span class="detail-label">Sector</span>
          <span>{{ sector }}</span>
        </div>
        {% endif %}
        {% if services %}
        <div class="project-detail-row">
          <span class="detail-label">Services</span>
          <span>{{ services | join(", ") }}</span>
        </div>
        {% endif %}
        {% if year %}
        <div class="project-detail-row">
          <span class="detail-label">Year</span>
          <span>{{ year }}</span>
        </div>
        {% endif %}
        {% if results %}
        <div class="project-detail-row project-results">
          <span class="detail-label">Results</span>
          <span>{{ results }}</span>
        </div>
        {% endif %}
      </div>
      <a href="/contact/" class="btn btn-lg project-sidebar-cta">Start Your Project</a>
    </aside>

    <div class="project-body">
      {{ content | safe }}
    </div>

  </div>
</section>

{% if gallery and gallery.length > 0 %}
<section class="section project-gallery-section">
  <div class="container">
    <p class="gallery-label">Project screens</p>
    <div class="gallery-slider" id="gallery-slider">
      <button class="gallery-nav gallery-nav--prev" id="gallery-prev" type="button" aria-label="Previous screenshot">←</button>
      <div class="gallery-viewport">
        <div class="gallery-track" id="gallery-track">
      {% for img in gallery %}
      <button
        class="gallery-item gallery-item--{{ img.device or 'desktop' }}"
        data-src="{{ img.url }}"
        data-alt="{{ img.alt }}"
        aria-label="View screenshot: {{ img.alt }}"
        type="button"
      >
        <div class="device-frame device-frame--{{ img.device or 'desktop' }}">
          {% if img.device == 'mobile' %}
          <div class="device-chrome device-chrome--mobile">
            <span class="device-speaker"></span>
          </div>
          {% else %}
          <div class="device-chrome device-chrome--browser">
            <span class="device-dot"></span>
            <span class="device-dot"></span>
            <span class="device-dot"></span>
            <div class="device-urlbar"></div>
          </div>
          {% endif %}
          <div class="device-screen">
            <img src="{{ img.url }}" alt="{{ img.alt }}" loading="lazy" />
          </div>
          {% if img.device == 'mobile' %}
          <div class="device-home-bar"></div>
          {% endif %}
        </div>
      </button>
      {% endfor %}
        </div>
      </div>
      <button class="gallery-nav gallery-nav--next" id="gallery-next" type="button" aria-label="Next screenshot">→</button>
    </div>
    {% if gallery.length > 1 %}
    <div class="gallery-dots" id="gallery-dots" aria-label="Gallery slide navigation"></div>
    {% endif %}
    </div>
  </div>
</section>

<div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true">
  <button class="lightbox-close" aria-label="Close" type="button">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>
  <div class="lightbox-stage">
    <img class="lightbox-img" src="" alt="" />
  </div>
</div>
{% endif %}
