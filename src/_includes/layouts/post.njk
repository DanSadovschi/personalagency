---
layout: layouts/base.njk
---

<section class="post-hero">
  <div class="hero-bg-grid"></div>
  <div class="container">
    <a href="/blog/" class="project-back">← All Articles</a>
    <div class="post-hero-meta">
      {% if category %}<span class="post-category-tag">{{ category }}</span>{% endif %}
      {% if readTime %}<span class="post-readtime">{{ readTime }}</span>{% endif %}
    </div>
    <h1>{{ title }}</h1>
    {% if description %}<p class="post-summary">{{ description }}</p>{% endif %}
    {% if date %}<time class="post-date" datetime="{{ date }}">{{ date | readableDate }}</time>{% endif %}
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="post-body reveal">
      {{ content | safe }}
    </div>
    <div class="post-cta reveal">
      <div class="post-cta-inner">
        <h3>Ready to get your business found on Google?</h3>
        <p>WebOrb builds fast websites for UK companies — designed to rank locally and turn visitors into paying clients.</p>
        <a href="/#contact" class="btn btn-lg">Get a Free Quote</a>
      </div>
    </div>
  </div>
</section>
