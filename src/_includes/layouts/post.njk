---
layout: layouts/base.njk
ogType: article
---

<section class="post-hero">
  <div class="hero-bg-grid"></div>
  <div class="container">
    <a href="/blog/" class="project-back">← All Articles</a>
    <div class="post-hero-meta">
      {% if category %}<span class="post-category-tag">{{ category }}</span>{% endif %}
      {% if readTime %}<span class="post-readtime">{{ readTime }}</span>{% endif %}
    </div>
    <h1>{{ title }}</h1>
    {% if description %}<p class="post-summary">{{ description }}</p>{% endif %}
    {% if date %}<time class="post-date" datetime="{{ date | toISODate }}">{{ date | readableDate }}</time>{% endif %}
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="post-body reveal">
      {{ content | safe }}
    </div>
    <div class="post-cta reveal">
      <div class="post-cta-inner">
        <h3>Need a website that actually performs?</h3>
        <p>WebOrb designs and builds custom websites for ambitious UK businesses — fast, SEO-ready, and built to convert.</p>
        <a href="/contact/" class="btn btn-lg">Start a Project</a>
      </div>
    </div>
  </div>
</section>

<!-- Structured Data: Article -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  {% if date %}"datePublished": "{{ date | toISODate }}",{% endif %}
  "author": {
    "@type": "Organization",
    "name": "WebOrb",
    "url": "https://web-orb.uk"
  },
  "publisher": {
    "@type": "Organization",
    "name": "WebOrb",
    "url": "https://web-orb.uk",
    "logo": {
      "@type": "ImageObject",
      "url": "https://web-orb.uk/img/og.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://web-orb.uk{{ page.url }}"
  }
}
</script>

<!-- Structured Data: BreadcrumbList -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://web-orb.uk/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://web-orb.uk/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ title }}",
      "item": "https://web-orb.uk{{ page.url }}"
    }
  ]
}
</script>
