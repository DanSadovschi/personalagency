<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ description }}" />
  <title>{{ title }}</title>
  {% if canonical %}<link rel="canonical" href="{{ canonical }}" />{% endif %}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  {% if ogTitle %}
  <meta property="og:type" content="website" />
  {% if canonical %}<meta property="og:url" content="{{ canonical }}" />{% endif %}
  <meta property="og:title" content="{{ ogTitle }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:site_name" content="WebOrb" />
  <meta property="og:image" content="{{ ogImage if ogImage else 'https://web-orb.uk/img/og.png' }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ ogTitle }}" />
  <meta name="twitter:description" content="{{ description }}" />
  <meta name="twitter:image" content="{{ ogImage if ogImage else 'https://web-orb.uk/img/og.png' }}" />
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
  <script>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
  <script defer src="/_vercel/insights/script.js"></script>
</head>
<body>

  <!-- ═══════════════════════════════ NAV ═══════════════════════════════ -->
  <nav id="nav">
    <div class="nav-inner">
      {% if page.url === "/" %}
      <a href="#" class="logo">Web<span>Orb</span><span class="dot">·</span></a>
      {% else %}
      <a href="/" class="logo">Web<span>Orb</span><span class="dot">·</span></a>
      {% endif %}
      <ul class="nav-links">
        <li><a href="{% if page.url === '/' %}#services{% else %}/#services{% endif %}">Services</a></li>
        <li><a href="/projects/"{% if activeNav === "projects" %} class="nav-active"{% endif %}>Projects</a></li>
        <li><a href="/templates/"{% if activeNav === "templates" %} class="nav-active"{% endif %}>Templates</a></li>
        <li><a href="/work/"{% if activeNav === "work" %} class="nav-active"{% endif %}>Founding Clients</a></li>
        <li><a href="{% if page.url === '/' %}#pricing{% else %}/#pricing{% endif %}">Pricing</a></li>
        <li><a href="{% if page.url === '/' %}#contact{% else %}/#contact{% endif %}">Contact</a></li>
      </ul>
      <a href="{{ navCtaHref if navCtaHref else ('/#contact' if page.url !== '/' else '#contact') }}" class="btn btn-sm">{{ navCtaText if navCtaText else 'Get a Quote' }}</a>
      <button class="nav-toggle" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="mobile-menu">
      <ul>
        <li><a href="{% if page.url === '/' %}#services{% else %}/#services{% endif %}">Services</a></li>
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/templates/">Templates</a></li>
        <li><a href="/work/">Founding Clients</a></li>
        <li><a href="{% if page.url === '/' %}#pricing{% else %}/#pricing{% endif %}">Pricing</a></li>
        <li><a href="{% if page.url === '/' %}#contact{% else %}/#contact{% endif %}">Contact</a></li>
        <li><a href="{{ navCtaHref if navCtaHref else ('/#contact' if page.url !== '/' else '#contact') }}" class="btn">{{ navCtaText if navCtaText else 'Get a Quote' }}</a></li>
      </ul>
    </div>
  </nav>

  {{ content | safe }}

  <!-- ══════════════════════════════ FOOTER ════════════════════════════ -->
  <footer>
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href="/" class="logo">Web<span>Orb</span><span class="dot">·</span></a>
        <p>Websites that win clients for growing UK companies.</p>
      </div>
      <div class="footer-links">
        <div class="footer-col">
          <h4>Services</h4>
          <ul>
            <li><a href="/#services">Web Design</a></li>
            <li><a href="/#services">Local SEO</a></li>
            <li><a href="/#services">Google Business</a></li>
            <li><a href="/#services">Landing Pages</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Company</h4>
          <ul>
            <li><a href="/projects/">Projects</a></li>
            <li><a href="/work/">Founding Clients</a></li>
            <li><a href="/#pricing">Pricing</a></li>
            <li><a href="/#contact">Contact</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Contact</h4>
          <ul>
            <li><a href="mailto:hello@web-orb.uk">hello@web-orb.uk</a></li>
            <li><a href="tel:+447594517540">07594 517 540</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        <p>&copy; 2026 WebOrb. All rights reserved.</p>
        <div class="footer-legal">
          <a href="/privacy-policy/">Privacy Policy</a>
          <a href="/terms/">Terms of Service</a>
        </div>
      </div>
    </div>
  </footer>

  {% if not noWaFloat %}
  <a href="https://wa.me/447594517540" class="wa-float" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>
  {% endif %}

  <script src="/js/main.js"></script>
</body>
</html>
