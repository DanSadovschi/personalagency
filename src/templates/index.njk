.tpl-card[data-new]::after{content:'NEW';position:absolute;top:12px;left:12px;background:var(--accent);color:#fff;font-size:.6rem;font-weight:700;letter-spacing:.1em;padding:3px 8px;border-radius:4px;z-index:2;}
/* empty state */
.tpl-empty{display:none;grid-column:1/-1;text-align:center;padding:80px 20px;color:var(--text-muted);}
.tpl-empty.visible{display:block;}
@media(max-width:640px){.tpl-filters{flex-direction:column;align-items:flex-start;}.tpl-filter-sort{width:100%;justify-content:space-between;}}
</style>

<script>
(function () {
  var grid    = document.getElementById('tplGrid');
  var pills   = document.querySelectorAll('.tpl-pill[data-filter]');
  var sortSel = document.getElementById('tplSort');
  var showing = document.getElementById('tplShowing');
  var countEl = document.getElementById('countAll');

  // Mark cards added within last 60 days
  var now = Date.now();
  grid.querySelectorAll('.tpl-card[data-date]').forEach(function (c) {
    if (now - new Date(c.dataset.date).getTime() < 60 * 24 * 3600 * 1000) {
      c.setAttribute('data-new', '');
    }
  });

  var activeTrade = 'all';
  countEl.textContent = '(' + grid.querySelectorAll('.tpl-card').length + ')';

  function applyFilters() {
    var cards = Array.from(grid.querySelectorAll('.tpl-card'));

    // Sort
    var sorted = cards.slice().sort(function (a, b) {
      var da = new Date(a.dataset.date || '2000-01-01');
      var db = new Date(b.dataset.date || '2000-01-01');
      return sortSel.value === 'newest' ? db - da : da - db;
    });
    sorted.forEach(function (c) { grid.appendChild(c); });

    // Filter
    var visible = 0;
    grid.querySelectorAll('.tpl-card').forEach(function (c) {
      var match = activeTrade === 'all' || c.dataset.trade === activeTrade;
      c.classList.toggle('tpl-hidden', !match);
      if (match) visible++;
    });

    // Empty state
    var empty = document.getElementById('tplEmpty');
    if (empty) empty.classList.toggle('visible', visible === 0);

    // Counter
    var total = grid.querySelectorAll('.tpl-card').length;
    showing.textContent = visible === total
      ? 'Showing all ' + total
      : 'Showing ' + visible + ' of ' + total;
  }

  pills.forEach(function (pill) {
    pill.addEventListener('click', function () {
      pills.forEach(function (p) { p.classList.remove('active'); });
      pill.classList.add('active');
      activeTrade = pill.dataset.filter;
      applyFilters();
    });
  });

  sortSel.addEventListener('change', applyFilters);

  applyFilters();
})();
</script>
