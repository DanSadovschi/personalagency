<style>
/* ── Hero ── */
.tpl-hero{padding:140px 0 80px;text-align:center;}
.tpl-hero h1{margin:16px 0 24px;}
.tpl-hero-sub{max-width:620px;margin:0 auto 48px;font-size:1.1rem;color:var(--text-muted);line-height:1.65;}
.tpl-tiers{display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;}
.tpl-tier{display:flex;flex-direction:column;align-items:center;gap:4px;}
.tpl-tier-price{font-size:1.5rem;font-weight:700;color:var(--text);}
.tpl-tier-label{font-size:0.78rem;color:var(--text-muted);}
.tpl-tier-sep{font-size:1.5rem;color:var(--border-mid);margin:0 4px;}

/* ── Grid ── */
.tpl-grid-section{padding:0 0 100px;}
.tpl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:28px;}
.tpl-card{background:var(--bg-surface);border:1px solid var(--border);border-radius:20px;overflow:hidden;transition:border-color .3s,transform .3s;}
.tpl-card:hover{border-color:var(--border-mid);transform:translateY(-3px);}
.tpl-card--soon{opacity:.7;}
.tpl-card--soon:hover{transform:none;}
.tpl-card-soon-badge{position:absolute;top:12px;right:12px;background:var(--bg-raised);border:1px solid var(--border-mid);color:var(--text-muted);font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;padding:4px 10px;border-radius:6px;z-index:2;}
.tpl-card{position:relative;}

/* Preview iframe */
.tpl-card-preview{display:block;width:100%;height:220px;overflow:hidden;background:var(--bg-raised);position:relative;cursor:pointer;text-decoration:none;}
.tpl-card-preview iframe{width:1280px;height:900px;border:none;transform-origin:top left;pointer-events:none;position:absolute;top:0;left:0;}
.tpl-card-overlay{position:absolute;inset:0;background:rgba(0,0,0,0);display:flex;align-items:center;justify-content:center;transition:background .25s;}
.tpl-card-preview:hover .tpl-card-overlay{background:rgba(0,0,0,.55);}
.tpl-card-preview-btn{color:#fff;font-size:15px;font-weight:600;opacity:0;transform:translateY(6px);transition:opacity .25s,transform .25s;}
.tpl-card-preview:hover .tpl-card-preview-btn{opacity:1;transform:translateY(0);}

/* Placeholder preview (no iframe) */
.tpl-card-preview--placeholder{display:flex;align-items:center;justify-content:center;cursor:default;background:rgba(calc(var(--hue,220) * 1deg),40%,15%,.4);}
.tpl-card-preview--placeholder svg{color:hsl(calc(var(--hue,220) * 1deg),60%,60%);opacity:.5;}

.tpl-card-body{padding:24px;}
.tpl-card-meta{display:flex;gap:8px;margin-bottom:12px;}
.tpl-card-tag{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--accent);background:rgba(79,142,247,.1);border:1px solid rgba(79,142,247,.2);padding:3px 10px;border-radius:20px;}
.tpl-card-body h3{margin:0 0 8px;font-size:1.1rem;}
.tpl-card-body p{font-size:0.875rem;color:var(--text-muted);margin:0 0 20px;line-height:1.6;}
.tpl-card-footer{display:flex;align-items:center;justify-content:space-between;}
.tpl-card-from{font-size:0.875rem;color:var(--text-muted);}
.tpl-card-from strong{color:var(--text);font-size:1.05rem;}

/* ── How it works ── */
.tpl-how{padding:80px 0 100px;border-top:1px solid var(--border);}
.tpl-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
@media(max-width:768px){.tpl-steps{grid-template-columns:1fr;}.tpl-grid{grid-template-columns:1fr;}}

/* ── CTA ── */
.tpl-cta{padding:0 0 120px;}
.tpl-cta-box{background:var(--bg-surface);border:1px solid var(--border);border-radius:24px;padding:72px 48px;text-align:center;}
.tpl-cta-box h2{margin:16px 0 16px;}
.tpl-cta-box p{max-width:500px;margin:0 auto 36px;color:var(--text-muted);}
@media(max-width:640px){.tpl-cta-box{padding:48px 24px;}.tpl-tiers{flex-direction:column;gap:8px;}.tpl-tier-sep{display:none;}}
</style>
