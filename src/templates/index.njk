/* ── Grid ── */
.tpl-grid-section{padding:0 0 100px;}
.tpl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:28px;}
.tpl-card{background:var(--bg-surface);border:1px solid var(--border);border-radius:20px;overflow:hidden;transition:border-color .3s,transform .3s;}
