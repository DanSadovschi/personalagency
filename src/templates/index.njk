.tpl-card-preview--placeholder{display:flex;align-items:center;justify-content:center;cursor:default;background:rgba(calc(var(--hue,220) * 1deg),40%,15%,.4);}
.tpl-card-preview--placeholder svg{color:hsl(calc(var(--hue,220) * 1deg),60%,60%);opacity:.5;}

.tpl-card-body{padding:24px;}
.tpl-card-meta{display:flex;gap:8px;margin-bottom:12px;}
.tpl-card-tag{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--accent);background:rgba(79,142,247,.1);border:1px solid rgba(79,142,247,.2);padding:3px 10px;border-radius:20px;}
.tpl-card-body h3{margin:0 0 8px;font-size:1.1rem;}
.tpl-card-body p{font-size:0.875rem;color:var(--text-muted);margin:0 0 20px;line-height:1.6;}
.tpl-card-footer{display:flex;align-items:center;justify-content:space-between;}
.tpl-card-from{font-size:0.875rem;color:var(--text-muted);}
.tpl-card-from strong{color:var(--text);font-size:1.05rem;}

/* ── How it works ── */
.tpl-how{padding:80px 0 100px;border-top:1px solid var(--border);}
.tpl-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
