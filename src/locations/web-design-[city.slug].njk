</head>
<body>

  <!-- ═══════════════════════════════ NAV ═══════════════════════════════ -->
  <nav id="nav">
    <div class="nav-inner">
      <a href="/" class="logo">Web<span>Orb</span><span class="dot">·</span></a>
      <ul class="nav-links">
        <li><a href="#services">Services</a></li>
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/templates/">Templates</a></li>
        <li><a href="/work/">Founding Clients</a></li>
        <li><a href="/#pricing">Pricing</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <a href="#contact" class="btn btn-sm">Get a Quote</a>
      <button class="nav-toggle" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="mobile-menu">
      <ul>
        <li><a href="#services">Services</a></li>
        <li><a href="/projects/">Projects</a></li>
        <li><a href="/templates/">Templates</a></li>
        <li><a href="/work/">Founding Clients</a></li>
        <li><a href="/#pricing">Pricing</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a href="#contact" class="btn">Get a Quote</a></li>
      </ul>
    </div>
  </nav>

  <!-- ═══════════════════════════════ HERO ══════════════════════════════ -->
  <section id="hero">
    <div class="hero-bg-grid"></div>
    <div class="container hero-content">
      <p class="hero-eyebrow reveal">Web design &amp; digital services in {{ city.name }}</p>
      <h1 class="hero-title reveal">
        {{ city.name }} websites that<br /><span class="accent">win clients.</span>
      </h1>
      <p class="hero-sub reveal">
        We build fast, professional websites for companies across {{ city.name }}<br class="br-lg" />
        — so the right customers find <em>you</em> first, and choose <em>you</em> over everyone else.
      </p>
      <div class="hero-ctas reveal">
        <a href="#contact" class="btn btn-lg">Get a Quote</a>
        <a href="/work/" class="btn btn-ghost btn-lg">See Our Work <span class="arrow">→</span></a>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="stats-bar reveal">
      <div class="container stats-inner">
        <div class="stat">
          <span class="stat-num" data-count="50">0</span><span class="stat-plus">+</span>
          <span class="stat-label">Projects Delivered</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">Client</span>
          <span class="stat-label">First Focus</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num" data-count="2">0</span>
          <span class="stat-label">Week Delivery</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">0</span>
          <span class="stat-label">Outsourcing</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ LOCAL INTRO ═══════════════ -->
  <section id="local" class="section">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-eyebrow">Serving {{ city.name }}</p>
        <h2>Built for {{ city.name }}.<br />Built around you.</h2>
      </div>
      <div class="pain-grid">
        <div class="pain-card reveal" style="grid-column: span 2">
          <p style="font-size:1.1rem; line-height:1.7;">{{ city.description }}</p>
          <p style="margin-top:1rem; color: var(--text-muted);">{{ city.localDetails }}</p>
        </div>
        <div class="pain-card reveal">
          <div class="pain-icon">
            <svg viewBox="0 0 40 40" fill="none"><path d="M20 4C13.373 4 8 9.373 8 16c0 9 12 20 12 20s12-11 12-20c0-6.627-5.373-12-12-12zm0 16a4 4 0 110-8 4 4 0 010 8z" stroke="currentColor" stroke-width="1.5"/></svg>
          </div>
          <h3>Local to {{ city.name }}</h3>
          <p>We understand the {{ city.name }} market. Your website will be written for the clients in your area — crafted around your offer, not copied from a shelf by a faceless agency.</p>
        </div>
        <div class="pain-card reveal">
          <div class="pain-icon">
            <svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="14" stroke="currentColor" stroke-width="1.5"/><path d="M20 13v7l5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3>Live in 2 weeks</h3>
          <p>No waiting months. We deliver your finished {{ city.name }} website in 2 weeks — so you can start getting found on Google straight away.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ SERVICES ═══════════════════════════ -->
  <section id="services" class="section section-dark">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-eyebrow">What we do</p>
        <h2>Everything you need<br />to win online in {{ city.name }}.</h2>
      </div>
      <div class="services-grid">
        <div class="service-card reveal">
          <div class="service-num">01</div>
          <h3>Web Design &amp; Development</h3>
          <p>Beautiful, fast websites built to turn {{ city.name }} visitors into real enquiries. Mobile-first, SEO-ready, delivered in 2 weeks.</p>
          <ul class="service-list">
            <li>Custom code, Webflow, Shopify or Bubble</li>
            <li>Mobile &amp; tablet optimised</li>
            <li>Contact forms &amp; click-to-call</li>
            <li>Hosted &amp; maintained for you</li>
          </ul>
        </div>
        <div class="service-card reveal">
          <div class="service-num">02</div>
          <h3>Local SEO for {{ city.name }}</h3>
          <p>Get found by clients searching for your services in {{ city.name }} on Google. Rank higher, get more calls from the right people.</p>
          <ul class="service-list">
            <li>{{ city.name }}-focused keyword optimisation</li>
            <li>Google Maps visibility</li>
            <li>On-page SEO included</li>
            <li>Monthly ranking reports</li>
          </ul>
        </div>
        <div class="service-card reveal">
          <div class="service-num">03</div>
          <h3>Google Business Profile</h3>
          <p>Set up and manage your Google Business listing so you show up when {{ city.name }} clients search for what you offer.</p>
          <ul class="service-list">
            <li>Full profile setup</li>
            <li>Review management</li>
            <li>Photo uploads &amp; updates</li>
            <li>Q&amp;A management</li>
          </ul>
        </div>
        <div class="service-card reveal">
          <div class="service-num">04</div>
          <h3>Landing Pages &amp; Ads</h3>
          <p>High-converting landing pages built to work with your Google Ads campaigns and drive real enquiries from {{ city.name }}.</p>
          <ul class="service-list">
            <li>Conversion-focused design</li>
            <li>A/B testing ready</li>
            <li>Google Ads integration</li>
            <li>Call tracking setup</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ PROJECTS ═══════════════════════════ -->
  {% if collections.projects and collections.projects.length > 0 %}
  <section id="projects" class="section">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-eyebrow">Our work</p>
        <h2>Projects we're<br />proud of.</h2>
      </div>
      <div class="projects-grid">
        {% set shown = 0 %}
        {% for project in collections.projects | reverse %}
          {% set projectCover = project.data.cover or (project.data.gallery and project.data.gallery[0] and project.data.gallery[0].url) %}
          {% if shown < 3 and projectCover %}
          <a href="{{ project.url }}" class="project-card reveal">
            <div class="project-card-cover">
              <img src="{{ projectCover }}" alt="{{ project.data.title }}" loading="lazy" />
              {% if project.data.sector %}
              <span class="project-sector-tag">{{ project.data.sector }}</span>
              {% endif %}
            </div>
            <div class="project-card-body">
              <h3>{{ project.data.title }}</h3>
              {% if project.data.summary %}<p>{{ project.data.summary }}</p>{% endif %}
              <span class="project-card-link">View project →</span>
            </div>
          </a>
          {% set shown = shown + 1 %}
          {% endif %}
        {% endfor %}
      </div>
      <div class="trust-cta reveal" style="margin-top:48px;">
        <a href="/projects/" class="btn btn-ghost">See all projects <span class="arrow">→</span></a>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ══════════════════════════════ TEMPLATES ══════════════════════════ -->
  <section id="templates" class="section section-dark">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-eyebrow">Ready-Made Templates</p>
        <h2>Need a site fast?<br />Pick a template.</h2>
      </div>
      <p class="reveal" style="max-width:600px;margin:0 auto 48px;text-align:center;color:var(--text-muted);font-size:1.05rem;">Choose a template built for your trade. We swap in your name, logo, phone and photos — live in 3 days from £49.</p>
      <div class="tpl-cards-row">

        <div class="tpl-card reveal">
          <a href="/templates/plumber/" class="tpl-card-preview" aria-label="Preview Plumber template">
            <iframe src="/templates/plumber/" title="Plumber template preview" tabindex="-1" loading="lazy"></iframe>
            <div class="tpl-card-overlay">
              <span class="tpl-card-preview-btn">Preview →</span>
            </div>
          </a>
          <div class="tpl-card-body">
            <div class="tpl-card-meta">
              <span class="tpl-card-tag">Plumber</span>
              <span class="tpl-card-tag">Heating</span>
            </div>
            <h3>Plumber Template</h3>
            <p>Clean, trustworthy design for plumbers and heating engineers. Emergency CTA, services grid, reviews section.</p>
            <div class="tpl-card-footer">
              <span class="tpl-card-from">from <strong>£49</strong></span>
              <a href="/templates/plumber/" class="btn btn-sm">Preview</a>
            </div>
          </div>
        </div>

        <div class="tpl-card reveal">
          <a href="/templates/electrician/" class="tpl-card-preview" aria-label="Preview Electrician template">
            <iframe src="/templates/electrician/" title="Electrician template preview" tabindex="-1" loading="lazy"></iframe>
            <div class="tpl-card-overlay">
              <span class="tpl-card-preview-btn">Preview →</span>
            </div>
          </a>
          <div class="tpl-card-body">
            <div class="tpl-card-meta">
              <span class="tpl-card-tag">Electrician</span>
              <span class="tpl-card-tag">EV Chargers</span>
            </div>
            <h3>Electrician Template</h3>
            <p>Dark, electric design with lightning animations, cursor sparks, typewriter hero, pricing table and NICEIC certs section.</p>
            <div class="tpl-card-footer">
              <span class="tpl-card-from">from <strong>£49</strong></span>
              <a href="/templates/electrician/" class="btn btn-sm">Preview</a>
            </div>
          </div>
        </div>

        <div class="tpl-card reveal">
          <a href="/templates/builder/" class="tpl-card-preview" aria-label="Preview Builder template">
            <iframe src="/templates/builder/" title="Builder template preview" tabindex="-1" loading="lazy"></iframe>
            <div class="tpl-card-overlay">
              <span class="tpl-card-preview-btn">Preview →</span>
            </div>
          </a>
          <div class="tpl-card-body">
            <div class="tpl-card-meta">
              <span class="tpl-card-tag">Builder</span>
              <span class="tpl-card-tag">Extensions</span>
            </div>
            <h3>Builder Template</h3>
            <p>Dark green design with before/after slider, interactive quote estimator, process steps, and trade partners marquee.</p>
            <div class="tpl-card-footer">
              <span class="tpl-card-from">from <strong>£49</strong></span>
              <a href="/templates/builder/" class="btn btn-sm">Preview</a>
            </div>
          </div>
        </div>

      </div>
      <div class="trust-cta reveal" style="margin-top:40px;">
        <a href="/templates/" class="btn btn-ghost">Browse all templates <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ CONTACT ════════════════════════════ -->
