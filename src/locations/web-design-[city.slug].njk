  <!-- ═══════════════ LOCAL INTRO ═══════════════ -->
  <section id="local" class="section">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-eyebrow">Serving {{ city.name }}</p>
        <h2>Built for {{ city.name }}<br />trades businesses.</h2>
      </div>
      <div class="pain-grid">
        <div class="pain-card reveal" style="grid-column: span 2">
          <p style="font-size:1.1rem; line-height:1.7;">{{ city.description }}</p>
          <p style="margin-top:1rem; color: var(--text-muted);">{{ city.localDetails }}</p>
        </div>
        <div class="pain-card reveal">
          <div class="pain-icon">
            <svg viewBox="0 0 40 40" fill="none"><path d="M20 4C13.373 4 8 9.373 8 16c0 9 12 20 12 20s12-11 12-20c0-6.627-5.373-12-12-12zm0 16a4 4 0 110-8 4 4 0 010 8z" stroke="currentColor" stroke-width="1.5"/></svg>
          </div>
          <h3>Local to {{ city.name }}</h3>
          <p>We understand the {{ city.name }} market. Your website will be written for the customers in your area, not a generic template from a faceless agency.</p>
        </div>
        <div class="pain-card reveal">
          <div class="pain-icon">
            <svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="14" stroke="currentColor" stroke-width="1.5"/><path d="M20 13v7l5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <h3>Live in 2 weeks</h3>
          <p>No waiting months. We deliver your finished {{ city.name }} website in 2 weeks — so you can start getting found on Google straight away.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ SERVICES ═══════════════════════════ -->
  <section id="services" class="section section-dark">
    <div class="container">
      <div class="section-header reveal">
        <p class="section-eyebrow">What we do</p>
        <h2>Everything you need<br />to win online in {{ city.name }}.</h2>
      </div>
      <div class="services-grid">
        <div class="service-card reveal">
          <div class="service-num">01</div>
          <h3>Web Design &amp; Development</h3>
          <p>Beautiful, fast websites built to convert {{ city.name }} visitors into enquiries. Mobile-first, SEO-ready, delivered in 2 weeks.</p>
          <ul class="service-list">
            <li>Custom design, no templates</li>
            <li>Mobile &amp; tablet optimised</li>
            <li>Contact forms &amp; click-to-call</li>
            <li>Hosted &amp; maintained for you</li>
          </ul>
        </div>
        <div class="service-card reveal">
          <div class="service-num">02</div>
          <h3>Local SEO for {{ city.name }}</h3>
          <p>Get found by customers searching for trades in {{ city.name }} on Google. Rank higher, get more calls from local jobs.</p>
          <ul class="service-list">
            <li>{{ city.name }}-focused keyword optimisation</li>
            <li>Google Maps visibility</li>
            <li>On-page SEO included</li>
            <li>Monthly ranking reports</li>
          </ul>
        </div>
        <div class="service-card reveal">
          <div class="service-num">03</div>
          <h3>Google Business Profile</h3>
          <p>Set up and manage your Google Business listing so you show up when {{ city.name }} customers search for your trade.</p>
          <ul class="service-list">
            <li>Full profile setup</li>
            <li>Review management</li>
            <li>Photo uploads &amp; updates</li>
            <li>Q&amp;A management</li>
          </ul>
        </div>
        <div class="service-card reveal">
          <div class="service-num">04</div>
          <h3>Landing Pages &amp; Ads</h3>
          <p>High-converting landing pages built to work with your Google Ads campaigns targeting {{ city.name }} customers.</p>
          <ul class="service-list">
            <li>Conversion-focused design</li>
            <li>A/B testing ready</li>
            <li>Google Ads integration</li>
            <li>Call tracking setup</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ CONTACT ════════════════════════════ -->
  <section id="contact" class="section">
    <div class="container">
      <div class="contact-inner">
        <div class="contact-left reveal">
          <p class="section-eyebrow">Get in touch</p>
          <h2>Let's talk.</h2>
          <p class="contact-sub">Tell us about your {{ city.name }} business. We'll come back to you within one working day with ideas and a no-obligation quote.</p>
          <div class="contact-details">
            <a href="mailto:hello@web-orb.uk" class="contact-link">hello@web-orb.uk</a>
            <a href="tel:+447594517540" class="contact-link">07594 517 540</a>
          </div>
        </div>
        <div class="contact-right reveal">
          <form id="contact-form" novalidate>
            <input type="hidden" name="access_key" value="f62a219f-a1b0-48cb-b607-fb887e18d0a4" />
            <input type="hidden" name="subject" value="New enquiry — WebOrb ({{ city.name }})" />
            <input type="hidden" name="redirect" value="false" />
            <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
            <div class="form-row">
              <div class="form-group">
                <label for="name">Your Name</label>
                <input type="text" id="name" name="name" placeholder="John Smith" required />
                <span class="field-error"></span>
              </div>
              <div class="form-group">
                <label for="trade">Your Trade</label>
                <select id="trade" name="trade" required>
                  <option value="" disabled selected>Select your trade</option>
                  <option value="garage">Auto Garage</option>
                  <option value="electrician">Electrician</option>
                  <option value="plumber">Plumber</option>
                  <option value="builder">Builder</option>
                  <option value="roofer">Roofer</option>
                  <option value="landscaper">Landscaper</option>
                  <option value="other">Other</option>
                </select>
                <span class="field-error"></span>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" placeholder="john@example.com" required />
                <span class="field-error"></span>
              </div>
              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="07700 900000" />
                <span class="field-error"></span>
              </div>
            </div>
            <div class="form-group">
              <label for="message">Tell us about your business</label>
              <textarea id="message" name="message" rows="4" placeholder="E.g. I'm an electrician in {{ city.name }} looking to get more local customers..."></textarea>
              <span class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-lg form-submit">
              <span class="btn-text">Send Message</span>
              <span class="btn-loading" hidden>Sending…</span>
            </button>
            <p class="form-success" hidden>Thanks! We'll be in touch within one working day.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

