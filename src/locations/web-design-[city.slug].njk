  <!-- ═══════════════════════════════ HERO ══════════════════════════════ -->
  <section id="hero">
    <div class="hero-bg-grid"></div>
    <div class="container hero-content">
      <p class="hero-eyebrow reveal">Web design for trades &amp; local businesses in {{ city.name }}</p>
      <h1 class="hero-title reveal">
        {{ city.name }} websites that<br /><span class="accent">win jobs.</span>
      </h1>
      <p class="hero-sub reveal">
        We build fast, professional websites for electricians, plumbers,<br class="br-lg" />
        garages &amp; tradespeople across {{ city.name }} — so local customers find <em>you</em> first.
      </p>
      <div class="hero-ctas reveal">
        <a href="#contact" class="btn btn-lg">Get a Free Quote</a>
        <a href="/work/" class="btn btn-ghost btn-lg">See Our Work <span class="arrow">→</span></a>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="stats-bar reveal">
      <div class="container stats-inner">
        <div class="stat">
          <span class="stat-num" data-count="10">0</span><span class="stat-plus">+</span>
          <span class="stat-label">Years in Web</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">Trades</span>
          <span class="stat-label">Only Focus</span>
        </div>
