  <!-- Structured Data: LocalBusiness -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": "https://web-orb.uk/#business",
    "name": "WebOrb — Web Design {{ city.name }}",
    "description": "Custom web design and local SEO for businesses in {{ city.name }}, {{ city.county }}. High-performance websites built with strategy, design, and clean code.",
    "url": "https://web-orb.uk/web-design-{{ city.slug }}/",
    "telephone": "+447594517540",
    "email": "hello@web-orb.uk",
    "priceRange": "££",
    "currenciesAccepted": "GBP",
    "areaServed": {
      "@type": "City",
      "name": "{{ city.name }}",
      "containedInPlace": {
        "@type": "AdministrativeArea",
        "name": "{{ city.county }}"
      }
    },
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "{{ city.county }}",
      "addressCountry": "GB"
    },
    "sameAs": [
      "https://wa.me/447594517540"
    ]
  }
  </script>

  <!-- Structured Data: BreadcrumbList -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://web-orb.uk/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Web Design {{ city.name }}",
        "item": "https://web-orb.uk/web-design-{{ city.slug }}/"
